# Public canonical origin. HTTPS origin only; do not include a path.
NEXT_PUBLIC_SITE_URL=

# Indexing stays disabled unless both this flag and a valid HTTPS site URL are set.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics are disabled unless a future provider is explicitly configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Membership checkout stays safely unavailable until every required value is set.
NEXT_PUBLIC_MEMBERSHIP_ENABLED=false
NEXT_PUBLIC_MEMBERSHIP_PRICE=
NEXT_PUBLIC_MEMBERSHIP_CURRENCY=
NEXT_PUBLIC_MEMBERSHIP_NETWORK=
NEXT_PUBLIC_MEMBERSHIP_WALLET_ADDRESS=
NEXT_PUBLIC_MEMBERSHIP_TELEGRAM_ADMIN=

# Optional Persian guidance shown above the payment details.
NEXT_PUBLIC_MEMBERSHIP_PAYMENT_GUIDE=
